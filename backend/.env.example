# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Firebase
# Download a service account key from Firebase Console > Project Settings > Service Accounts
# and place the JSON file at the path below (do NOT commit it - it's in .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# OpenAI (only required for AI features)
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o
